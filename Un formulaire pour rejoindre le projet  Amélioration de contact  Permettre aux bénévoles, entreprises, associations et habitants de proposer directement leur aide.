
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Rejoindre le projet | Accueil de Jour 18-25ans</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f2e8;
      color: #333;
      line-height: 1.7;
    }

    header {
      background: #245c43;
      color: white;
      text-align: center;
      padding: 45px 20px;
    }

    header h1 {
      margin-bottom: 10px;
      font-size: 2.2em;
    }

    nav {
      background: #174531;
      text-align: center;
      padding: 15px;
    }

    nav a {
      display: inline-block;
      color: white;
      text-decoration: none;
      margin: 5px 12px;
      font-weight: bold;
    }

    nav a:hover {
      color: #d5a843;
    }

    .container {
      max-width: 900px;
      margin: auto;
      padding: 25px 20px;
    }

    section {
      background: white;
      padding: 25px;
      margin-bottom: 25px;
      border-radius: 15px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.07);
    }

    h2, h3 {
      color: #245c43;
    }

    .intro {
      background: #e6ecdf;
      border-left: 6px solid #d5a843;
      border-radius: 12px;
      padding: 25px;
      margin-bottom: 25px;
    }

    .form-group {
      margin-bottom: 20px;
    }

    label {
      display: block;
