      background: #e2eee2;
      padding: 30px;
      border-radius: 15px;
      text-align: center;
      margin: 35px 0;
    }

    .callout h2 {
      color: #234d38;
    }

    .contact {
      background: white;
      padding: 30px;
      text-align: center;
      border-radius: 15px;
      margin-top: 30px;
    }

    .contact a {
      display: inline-block;
      background: #2e6946;
      color: white;
      text-decoration: none;
